# Local settings. Copy to .env, which git ignores. Never commit real secrets.

# Postgres from `docker compose up -d db`, for `npm run dev` and the db:* scripts.
DATABASE_URL="postgres://app:app@localhost:5432/app"

# The app's own address, for `npm run preview` (`npm run dev` doesn't need it).
ORIGIN="http://localhost:4173"

# First admin, added when an empty database is seeded (`npm run db:seed`, or SEED_ON_START=1).
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD=""

# Demo users and content, for trying the app with realistic data (src/lib/server/seed/demo.ts).
# Demo users can sign in only with SEED_DEMO_PASSWORD; without it each gets a random password.
# SEED_DEMO="1"
# SEED_DEMO_PASSWORD=""

# Uploads to an S3-compatible bucket (private). Leave unset to turn uploads off.
# S3_ENDPOINT="https://s3.example.com"
# S3_REGION="us-east-1"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PREFIX="local/"
